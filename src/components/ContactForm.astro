---
import { site } from '../data/site';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const interests = [
  'Product & Growth Diagnostic',
  'Position-to-Launch Sprint',
  'Conversion & Growth Sprint',
  'Fractional engagement',
  'Career opportunity',
  'Something else',
];
---

<form class="contact-form" action="/api/contact" method="post" data-contact-form>
  <div class="field-pair">
    <label>
      <span>Name</span>
      <input name="name" autocomplete="name" required minlength="2" />
    </label>
    <label>
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
  </div>

  <div class="field-pair">
    <label>
      <span>Company <small>(optional)</small></span>
      <input name="company" autocomplete="organization" />
    </label>
    <label>
      <span>What are you exploring?</span>
      <select name="interest">
        {interests.map((interest) => <option>{interest}</option>)}
      </select>
    </label>
  </div>

  <label>
    <span>What is happening, and what would a useful outcome look like?</span>
    <textarea name="message" rows="7" required minlength="30"></textarea>
  </label>

  <label class="honeypot" aria-hidden="true">
    <span>Website</span>
    <input name="website" tabindex="-1" autocomplete="off" />
  </label>
  <input name="source" type="hidden" value={Astro.url.pathname} />
  {turnstileSiteKey && (
    <>
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </>
  )}

  <div class="form-footer">
    <button class="button" type="submit">Send the brief</button>
    <p>Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const emitAnalytics = (event: string, properties: Record<string, string>) => {
    document.dispatchEvent(new CustomEvent('harkingbade:track', { detail: { event, properties } }));
  };
  const selectedInterest = () => {
    const field = form?.elements.namedItem('interest');
    return field instanceof HTMLSelectElement ? field.value : 'unknown';
  };
  let contactStarted = false;
  if (form) {
    form.dataset.enhanced = 'true';
    const aliases: Record<string, string> = {
      diagnostic: 'Product & Growth Diagnostic',
      launch: 'Position-to-Launch Sprint',
      conversion: 'Conversion & Growth Sprint',
      fractional: 'Fractional engagement',
      career: 'Career opportunity',
    };
    const params = new URLSearchParams(window.location.search);
    const requested = params.get('interest') ?? '';
    const selected = aliases[requested] ?? requested;
    const interest = form.elements.namedItem('interest');
    if (interest instanceof HTMLSelectElement && [...interest.options].some((option) => option.value === selected)) {
      interest.value = selected;
    }
    const source = form.elements.namedItem('source');
    if (source instanceof HTMLInputElement) {
      source.value = `${window.location.pathname}${window.location.search}`;
    }
  }

  form?.addEventListener('focusin', () => {
    if (contactStarted) return;
    contactStarted = true;
    emitAnalytics('contact_start', {
      source_page: window.location.pathname,
      interest: selectedInterest(),
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    status.dataset.state = 'pending';
    status.textContent = 'Sending…';

    try {
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form).entries()) {
        if (typeof value === 'string') params.append(key, value);
      }
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'content-type': 'application/x-www-form-urlencoded' },
        body: params,
      });
      const result = await response.json() as { ok?: boolean; message?: string; error?: string };
      status.dataset.state = result.ok ? 'success' : 'error';
      status.textContent = result.ok ? (result.message ?? 'Sent.') : (result.error ?? 'Unable to send.');
      emitAnalytics(result.ok ? 'contact_submit_success' : 'contact_submit_error', {
        source_page: window.location.pathname,
        ...(result.ok
          ? { interest: selectedInterest() }
          : { error_class: `http_${response.status}` }),
      });
      if (result.ok) form.reset();
    } catch {
      status.dataset.state = 'error';
      status.textContent = 'Unable to send right now. Please use the email address above.';
      emitAnalytics('contact_submit_error', {
        source_page: window.location.pathname,
        error_class: 'network',
      });
    } finally {
      if (button) button.disabled = false;
    }
  });

</script>

<style>
  .contact-form { display: grid; gap: 1.25rem; padding: clamp(1.35rem, 3.5vw, 2.5rem); border: 1px solid var(--ink); border-radius: var(--radius); background: var(--paper-2); box-shadow: .65rem .65rem 0 var(--lime); }
  .field-pair { display: grid; gap: 1.25rem; grid-template-columns: 1fr 1fr; }
  label { display: grid; gap: .45rem; }
  label > span { font-size: .8rem; font-weight: 850; }
  small { color: var(--ink-2); font-weight: 500; }
  input, textarea, select { width: 100%; border: 1px solid var(--line); border-radius: .45rem; color: var(--ink); background: #fff; }
  input, select { min-height: 3.25rem; padding: .65rem .75rem; }
  textarea { min-height: 10rem; padding: .75rem; resize: vertical; }
  input:focus, textarea:focus, select:focus { border-color: var(--blue); outline: 2px solid var(--blue); outline-offset: 1px; }
  .honeypot { position: absolute; left: -9999px; }
  .form-footer { display: flex; gap: 1rem; align-items: center; justify-content: space-between; }
  .form-footer p { color: var(--ink-2); font-size: .82rem; }
  .form-status { min-height: 1.5rem; font-size: .9rem; font-weight: 750; }
  .form-status[data-state='error'] { color: #a52912; }
  .form-status[data-state='success'] { color: #176735; }
  button:disabled { cursor: wait; opacity: .55; }
  @media (max-width: 650px) { .field-pair { grid-template-columns: 1fr; } .form-footer { align-items: flex-start; flex-direction: column; } }
</style>
