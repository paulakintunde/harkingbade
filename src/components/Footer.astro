---
import { navigation, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div><p class="eyebrow">Harkingbade / placeholder system</p><p class="footer-title">Make the next useful move.</p><a class="button button--light" href="/contact/">Start a project ↗</a></div>
    <div><p class="label">Explore</p><nav class="footer-nav" aria-label="Footer navigation">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}<a href="/resources/">Resources</a></nav></div>
    <div><p class="label">Contact</p><nav class="footer-nav" aria-label="Contact links"><a href={`mailto:${site.email}`}>{site.email}</a><a href="/newsletter/">Newsletter</a><a href="/rss.xml">RSS feed</a></nav></div>
  </div>
  <div class="container footer-base"><p>© {year} {site.name}</p><nav aria-label="Legal navigation"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav></div>
</footer>
