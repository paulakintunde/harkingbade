---
import { navigation, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-mark" aria-hidden="true">H</span>
      <span>{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <a class="header-cta" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
        <a href="/contact/">Start a conversation</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .skip-link { position: fixed; z-index: 100; top: .75rem; left: .75rem; padding: .7rem 1rem; transform: translateY(-180%); color: var(--paper-2); background: var(--blue); font-weight: 800; }
  .skip-link:focus { transform: translateY(0); }
  .site-header { position: sticky; z-index: 50; top: 0; border-bottom: 1px solid rgba(23, 33, 28, .28); background: rgba(244, 240, 231, .92); backdrop-filter: blur(14px); }
  .header-inner { display: grid; min-height: 4.7rem; grid-template-columns: 1fr auto 1fr; gap: 1.25rem; align-items: center; }
  .brand { display: inline-flex; width: fit-content; gap: .7rem; align-items: center; font-size: .95rem; font-weight: 900; letter-spacing: -.02em; text-decoration: none; }
  .brand-mark { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .35rem; color: var(--lime); background: var(--ink); font-family: var(--serif); font-size: 1.25rem; }
  .desktop-nav { display: flex; gap: 1.35rem; align-items: center; }
  .desktop-nav a { position: relative; font-size: .83rem; font-weight: 750; text-decoration: none; }
  .desktop-nav a::after { position: absolute; right: 0; bottom: -.4rem; left: 0; height: 2px; transform: scaleX(0); background: var(--blue); content: ''; transition: transform .16s ease; }
  .desktop-nav a:hover::after, .desktop-nav a[aria-current='page']::after { transform: scaleX(1); }
  .header-cta { justify-self: end; font-size: .82rem; font-weight: 800; text-decoration: none; }
  .header-cta span { color: var(--blue); }
  .mobile-nav { display: none; justify-self: end; }
  .mobile-nav summary { padding: .5rem .7rem; border: 1px solid var(--ink); border-radius: 999px; font-size: .8rem; font-weight: 800; cursor: pointer; list-style: none; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav { position: absolute; top: calc(100% + 1px); right: 0; left: 0; display: grid; padding: 1rem; border-bottom: 1px solid var(--ink); background: var(--paper-2); box-shadow: var(--shadow); }
  .mobile-nav nav a { padding: .85rem; border-bottom: 1px solid var(--line); font-weight: 750; text-decoration: none; }
  @media (max-width: 820px) {
    .header-inner { grid-template-columns: 1fr auto; }
    .desktop-nav, .header-cta { display: none; }
    .mobile-nav { display: block; }
  }
</style>
