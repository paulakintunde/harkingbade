---
const stages = [
  { number: '01', title: 'Notice', body: 'Placeholder for the signal, context, or friction worth understanding.' },
  { number: '02', title: 'Shape', body: 'Placeholder for the strategy, story, and experience that make the opportunity legible.' },
  { number: '03', title: 'Ship', body: 'Placeholder for the build, launch, and learning loop that keeps the work moving.' },
];
---
<ol class="process-rail" aria-label="Working method">{stages.map((stage) => <li><span class="label">{stage.number}</span><h3>{stage.title}</h3><p>{stage.body}</p></li>)}</ol>
