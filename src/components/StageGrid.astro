---
import { systemStages } from '../data/site';
---

<ol class="stage-grid" aria-label="The 4D Product and Growth System">
  {systemStages.map((stage) => (
    <li>
      <div class="stage-top"><span>{stage.number}</span><span aria-hidden="true">↘</span></div>
      <h3>{stage.name}</h3>
      <p class="stage-short">{stage.short}</p>
      <p>{stage.description}</p>
    </li>
  ))}
</ol>

<style>
  .stage-grid { display: grid; border-top: 1px solid currentColor; border-left: 1px solid currentColor; list-style: none; grid-template-columns: repeat(4, 1fr); }
  li { min-height: 22rem; padding: 1.4rem; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; }
  .stage-top { display: flex; margin-bottom: 4rem; justify-content: space-between; font-family: var(--mono); font-size: .75rem; font-weight: 800; }
  .stage-top span:last-child { color: var(--lime); font-size: 1.4rem; }
  h3 { margin-bottom: .55rem; font-family: var(--serif); font-size: clamp(2rem, 3.4vw, 3.5rem); font-weight: 500; }
  .stage-short { margin-bottom: 1rem; font-weight: 850; }
  li > p:last-child { color: #c8d1ca; font-size: .92rem; }
  @media (max-width: 900px) { .stage-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .stage-grid { grid-template-columns: 1fr; } li { min-height: 17rem; } }
</style>
