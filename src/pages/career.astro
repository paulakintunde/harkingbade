---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';

const roleFamilies = [
  {
    name: 'Growth Product',
    fit: 'Roles connecting customer evidence, opportunity framing, prioritization, activation, conversion, and measurable learning.',
    contribution: 'Turn an ambiguous growth problem into a decision, shipped intervention, and experiment loop.',
  },
  {
    name: 'Product Marketing',
    fit: 'Roles connecting customer language, positioning, value proposition, launch, content, and product adoption.',
    contribution: 'Keep the market promise, product experience, and go-to-market work attached to the same evidence.',
  },
  {
    name: 'Digital Product & Ecommerce',
    fit: 'Roles spanning customer journey, conversion, content, platform delivery, and cross-functional commercial outcomes.',
    contribution: 'Diagnose where the journey breaks and coordinate the smallest useful product, message, or experience change.',
  },
  {
    name: 'Zero-to-One Product Operator',
    fit: 'Lean environments that need structured discovery, clear decisions, practical implementation, and accountable follow-through.',
    contribution: 'Move from unclear opportunity to a credible first system without losing the customer or commercial thread.',
  },
];

const evidence = [
  {
    discipline: 'Product strategy',
    proof: 'Reframed a broad publishing site into a two-sided career and services system with explicit audiences, offers, gates, and measures.',
    link: '/work/harkingbade-recovery/',
    label: 'Recovery case study',
    status: 'Public evidence',
  },
  {
    discipline: 'Positioning & product marketing',
    proof: 'Created a category, promise, audience hierarchy, offer architecture, and 4D operating narrative from a scattered skills inventory.',
    link: '/insights/why-product-brand-and-growth-break/',
    label: 'Read the point of view',
    status: 'Public evidence',
  },
  {
    discipline: 'Research & content systems',
    proof: 'Audited 12,388 archive captures, normalized 737 paths, built a private evidence importer, and refused blanket redirects or fake freshness.',
    link: '/work/harkingbade-recovery/',
    label: 'Review the evidence ledger',
    status: 'Public evidence',
  },
  {
    discipline: 'Web & platform delivery',
    proof: 'Built a static-first Astro site with typed content, technical SEO, Cloudflare Worker APIs, release environments, and rollback controls.',
    link: '/insights/migrating-wordpress-to-astro-cloudflare/',
    label: 'Read the implementation note',
    status: 'Public evidence',
  },
  {
    discipline: 'Growth & lifecycle design',
    proof: 'Productized the 4D model as a browser-only diagnostic and built a consent-aware, safely gated newsletter acquisition path.',
    link: '/resources/4d-diagnostic/',
    label: 'Use the diagnostic',
    status: 'Public evidence',
  },
  {
    discipline: 'Program & delivery risk',
    proof: 'Separated staging and production, added a true 404, security headers, structured logs, smoke checks, dry runs, and evidence-based cutover gates.',
    link: '/work/harkingbade-recovery/',
    label: 'See the delivery record',
    status: 'Public evidence',
  },
  {
    discipline: 'Ecommerce outcomes',
    proof: 'Specific projects, commercial metrics, platforms, and role history have not yet been approved for public use.',
    link: '/contact/?interest=career',
    label: 'Request verified context',
    status: 'Founder evidence required',
  },
];
---

<BaseLayout
  title={`Career profile — ${site.name}`}
  description="A proof-led career profile for product, product marketing, growth, digital product, ecommerce, and zero-to-one roles."
>
  <header class="career-hero section--ink">
    <div class="container split">
      <div class="stack-lg">
        <p class="eyebrow">Career profile</p>
        <h1>Connect the decision<br />to the <span>delivery.</span></h1>
      </div>
      <div class="flow-end stack-lg">
        <p class="lede">Harkingbade demonstrates a cross-functional operating style: understand the customer and commercial context, make the product and positioning choices clear, ship the useful intervention, and measure what changes.</p>
        <div class="notice"><strong>Evidence boundary</strong>This page shows only work that can be inspected publicly in the Harkingbade rebuild. Founder identity, résumé, employment history, private project outcomes, references, location, and work authorization remain unpublished until supplied and approved.</div>
        <div class="button-row"><a class="button button--light" href="/work/" data-track-event="cta_click" data-track-cta="career-work" data-track-audience="career">Inspect the work</a><a class="button button--ghost" href="/contact/?interest=career" data-track-event="career_intent">Discuss a role</a></div>
      </div>
    </div>
  </header>

  <section class="section section--paper">
    <div class="container">
      <SectionHeading
        eyebrow="Value to a team"
        title="Cross-functional, with a reason."
        description="Breadth is useful when it reduces ambiguity, improves handoffs, and keeps customer evidence connected to commercial delivery."
      />
      <div class="value-grid">
        <article><span>01</span><h3>Frame the real problem</h3><p>Separate symptoms, requests, assumptions, and constraints before a team commits to output.</p></article>
        <article><span>02</span><h3>Make the choice legible</h3><p>Turn research into a clear priority, position, offer, journey, or success measure that functions can align around.</p></article>
        <article><span>03</span><h3>Close the strategy gap</h3><p>Work close enough to content, web, analytics, launch, and operations to make the decision tangible.</p></article>
        <article><span>04</span><h3>Build the learning loop</h3><p>Define the evidence that will keep, improve, scale, consolidate, or stop the work.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Role families"
        title="Where this operating range is most useful."
        description="These are role hypotheses, not a claim of past titles. Final priorities depend on verified résumé evidence and the target market."
      />
      <div class="role-list">
        {roleFamilies.map((role, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{role.name}</h3><p>{role.fit}</p></div>
            <div><strong>Useful contribution</strong><p>{role.contribution}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <SectionHeading
        eyebrow="Capability evidence"
        title="Inspect the artifact, not the adjective."
        description="Every public capability below points to work that exists now. Unverified founder history remains visibly separate."
      />
      <div class="evidence-table" role="table" aria-label="Capability evidence">
        <div class="evidence-head" role="row"><span role="columnheader">Capability</span><span role="columnheader">Current evidence</span><span role="columnheader">Status and route</span></div>
        {evidence.map((item) => (
          <article role="row">
            <h3 role="cell">{item.discipline}</h3>
            <p role="cell">{item.proof}</p>
            <div role="cell"><span class:list={['tag', item.status !== 'Public evidence' && 'tag--pending']}>{item.status}</span><a href={item.link}>{item.label} <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper application-system">
    <div class="container split">
      <div>
        <p class="eyebrow">Application system</p>
        <h2>One anchor role.<br />One credible proof route.</h2>
      </div>
      <div class="flow-end stack-lg">
        <p class="lede">Breadth becomes useful when each application translates it into one mandate. The anchor role must be selected from verified founder evidence, market demand, and the work Harkingbade should be hired to do repeatedly.</p>
        <ol class="application-steps">
          <li><strong>Choose</strong><span>Score the four role families against outcomes, artifact depth, recency, market demand, preference, and credibility gaps.</span></li>
          <li><strong>Translate</strong><span>Use the employer's mandate language while preserving an honest boundary between responsibility, artifact, and measured result.</span></li>
          <li><strong>Prove</strong><span>Route the most consequential claim to one or two relevant artifacts—not the entire website.</span></li>
          <li><strong>Learn</strong><span>Track conversations, stage progression, objections, and missing proof before increasing application volume.</span></li>
        </ol>
        <div class="button-row no-print">
          <button class="button button--ghost" type="button" data-career-print>Print this evidence profile</button>
          <a class="button button--ghost" href="/contact/?interest=career" data-track-event="career_intent">Discuss a role</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--coral">
    <div class="container split due-diligence">
      <div><p class="eyebrow">Hiring due diligence</p><h2>A useful interview should test the decisions.</h2></div>
      <div class="flow-end prose">
        <p>Ask for the context, evidence, alternatives, tradeoffs, implementation constraints, and measurement decision behind any artifact. Strong fit should survive that inspection.</p>
        <ul><li>What changed between the initial brief and the final decision?</li><li>Which assumption carried the most risk?</li><li>What was implemented directly, coordinated, or intentionally deferred?</li><li>Which result is measured, founder-reported, provisional, or still unknown?</li><li>What evidence would cause the strategy to change next?</li></ul>
      </div>
    </div>
  </section>

  <section class="section section--lime">
    <div class="container split">
      <div><p class="eyebrow">Career conversation</p><h2>Bring the role, mandate, and constraints.</h2></div>
      <div class="flow-end stack-lg"><p class="lede">A useful first note includes the product or business context, what the role owns, the team shape, location or time-zone constraints, and the outcome expected in the first six months.</p><div class="button-row"><a class="button" href="/contact/?interest=career" data-track-event="career_intent">Discuss an opportunity</a><a class="button button--ghost" href="/work/" data-track-event="cta_click" data-track-cta="career-work-footer" data-track-audience="career">Review the work first</a></div></div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-career-print]')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('harkingbade:track', {
      detail: {
        event: 'resource_use',
        properties: {
          source_page: window.location.pathname,
          resource_id: 'career-profile',
          action: 'print',
        },
      },
    }));
    window.print();
  });
</script>

<style>
  .career-hero { padding-block: clamp(6rem, 12vw, 10rem); }
  .career-hero h1 { font-size: clamp(3.5rem, 7.5vw, 7rem); }
  .career-hero h1 span { color: var(--lime); font-style: italic; }
  .value-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
  .value-grid article { min-height: 18rem; padding: 1.5rem; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .value-grid span, .role-list > article > span { color: var(--blue); font-family: var(--mono); font-size: .72rem; font-weight: 850; }
  .value-grid h3 { margin-block: 4rem 1rem; font-size: 1.45rem; }
  .value-grid p, .role-list p, .evidence-table p { color: var(--ink-2); font-size: .92rem; }
  .role-list { border-top: 1px solid var(--ink); }
  .role-list article { display: grid; padding-block: 1.5rem; grid-template-columns: 4rem minmax(0, 1fr) minmax(18rem, .75fr); gap: 1.5rem; border-bottom: 1px solid var(--ink); }
  .role-list h3 { margin-bottom: .5rem; font-size: clamp(1.5rem, 3vw, 2.25rem); }
  .role-list strong { display: block; margin-bottom: .5rem; font-family: var(--mono); font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; }
  .evidence-table { border-top: 1px solid #526157; }
  .evidence-head, .evidence-table article { display: grid; grid-template-columns: minmax(10rem, .65fr) minmax(0, 1.5fr) minmax(12rem, .65fr); gap: 1.5rem; }
  .evidence-head { padding-block: .8rem; color: var(--lime); font-family: var(--mono); font-size: .68rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .evidence-table article { padding-block: 1.4rem; align-items: start; border-top: 1px solid #526157; }
  .evidence-table article h3 { font-size: 1.1rem; }
  .evidence-table article p { color: #d9e0da; }
  .evidence-table article div { display: grid; justify-items: start; gap: .7rem; }
  .evidence-table article a { color: var(--paper-2); font-size: .82rem; font-weight: 800; }
  .evidence-table article a span { color: var(--lime); }
  .tag--pending { color: var(--paper-2); background: #526157; }
  .application-steps { display: grid; gap: 0; list-style: none; counter-reset: application; }
  .application-steps li { display: grid; padding: 1.05rem 0; grid-template-columns: 3rem minmax(7rem, .35fr) minmax(0, 1fr); gap: 1rem; border-bottom: 1px solid var(--line); }
  .application-steps li::before { color: var(--blue); font-family: var(--mono); font-size: .7rem; content: '0' counter(application); counter-increment: application; }
  .application-steps span { color: var(--ink-2); font-size: .9rem; }
  .due-diligence { align-items: start; }
  .due-diligence li { margin-bottom: .55rem; }
  @media (max-width: 900px) { .value-grid { grid-template-columns: 1fr 1fr; } .role-list article { grid-template-columns: 3rem 1fr; } .role-list article > div:last-child { grid-column: 2; } }
  @media (max-width: 680px) { .value-grid { grid-template-columns: 1fr; } .evidence-head { display: none; } .evidence-table article { grid-template-columns: 1fr; gap: .75rem; } .application-steps li { grid-template-columns: 2rem 1fr; } .application-steps strong, .application-steps span { grid-column: 2; } }
  @media print { :global(.site-header), :global(.site-footer), .no-print, .career-hero .button-row { display: none !important; } .career-hero, .section { padding-block: 1.5rem; } .career-hero h1 { font-size: 3.5rem; } .value-grid article { min-height: 0; } }
</style>
