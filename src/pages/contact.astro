---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
const enabled = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true';
---
<BaseLayout title={`Contact — ${site.name}`}><section class="hero"><div class="container hero-copy"><p class="eyebrow">Contact / placeholder</p><h1>Bring one useful question.</h1><p class="lede">Share the context, constraint, and desired next move. The full brief structure comes later.</p></div></section><section class="section section--white"><div class="container panel">{enabled ? <ContactForm /> : <div class="stack"><p class="eyebrow">Direct route</p><h2>The form is paused.</h2><p>Send a short note to <a href={`mailto:${site.email}`}>{site.email}</a>. Please do not include passwords or confidential data.</p></div>}</div></section></BaseLayout>
