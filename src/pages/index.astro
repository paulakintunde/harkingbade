  .section-intro p:last-child { margin-bottom: .4rem; color: #686c65; }
  .capability-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid #bfc3bc; }
  .capability { position: relative; min-height: 15rem; padding: 1.5rem 2rem 1.5rem 0; border-bottom: 1px solid #bfc3bc; }
  .capability:nth-child(odd) { padding-right: 3rem; border-right: 1px solid #bfc3bc; }
  .capability:nth-child(even) { padding-left: 3rem; }
  .item-number { color: #ff5b36; font-family: monospace; font-size: .68rem; }
  .capability h3 { max-width: 12ch; margin: 3.5rem 0 .8rem; }
  .capability p { color: #686c65; }
  .item-arrow { position: absolute; top: 1.5rem; right: 1rem; font-size: 1.5rem; }
  .section-dark { color: #f3f4ef; background: #171817; }
  .section-dark .eyebrow { color: #ff5b36; }
  .section-dark .section-intro p:last-child { color: #a6aaa3; }
  .situation-list { border-top: 1px solid #454843; }
  .situation { display: grid; padding: 2.2rem 0; grid-template-columns: 1fr 1fr; gap: 4rem; border-bottom: 1px solid #454843; }
  .situation h3 { max-width: 18ch; margin: .6rem 0 0; }
  .situation p { display: flex; gap: 1.1rem; align-items: flex-start; color: #b6bbb3; }
  .situation p span { color: #ff5b36; font-size: 1.4rem; line-height: 1; }
  .work-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .work-card { display: grid; min-height: 24rem; padding: 1.3rem; align-content: space-between; background: #e2e4dc; transition: transform 200ms cubic-bezier(.23,1,.32,1), background-color 200ms ease-out; }
  .work-card:nth-child(2) { background: #ff5b36; }
  .work-card:nth-child(3) { color: #f3f4ef; background: #171817; }
  .work-card-top { display: flex; justify-content: space-between; font-family: monospace; font-size: .65rem; text-transform: uppercase; }
  .work-card h3 { max-width: 10ch; margin-bottom: .8rem; }
  .work-card p { color: #686c65; }
  .work-card:nth-child(3) p { color: #b6bbb3; }
  .work-card a { width: fit-content; font-size: .78rem; font-weight: 800; text-decoration: none; }
  .work-card a:hover { text-decoration: underline; }
  .method-section { background: #dce5d1; }
  .method-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 10vw, 10rem); }
  .method-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid #8e9b87; }
  .method-item { display: grid; padding: 1.4rem 0; grid-template-columns: 4rem 1fr; gap: 1rem; border-bottom: 1px solid #8e9b87; }
  .method-item > span { color: #ff5b36; font-family: monospace; font-size: .7rem; }
  .method-item h3 { margin: 0 0 .5rem; }
  .method-item p { margin: 0; color: #5d675a; }
  .lab-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 5rem; align-items: center; }
  .lab-visual { position: relative; min-height: 25rem; overflow: hidden; background: #171817; }
  .lab-line { position: absolute; height: 1px; background: #ff5b36; transform-origin: left; }
  .line-a { top: 46%; right: 14%; left: 12%; transform: rotate(-18deg); }
  .line-b { top: 47%; right: 12%; left: 14%; transform: rotate(22deg); }
  .lab-node { position: absolute; display: grid; width: 5rem; height: 5rem; place-items: center; border: 1px solid #f3f4ef; border-radius: 50%; color: #f3f4ef; font-family: monospace; font-size: .7rem; }
  .node-a { top: 16%; left: 12%; }
  .node-b { top: 37%; left: 42%; color: #171817; background: #ff5b36; }
  .node-c { right: 12%; bottom: 14%; }
  .lab-label { position: absolute; right: 1rem; bottom: 1rem; }
  .closing { padding: clamp(6rem, 13vw, 13rem) 0; background: #ff5b36; }
  .closing-inner { display: grid; gap: 1.5rem; }
  .closing h2 { max-width: 8ch; }
  .closing .eyebrow { color: #171817; }
  .closing .button { width: fit-content; }
  .site-footer { padding: 1.5rem 0; color: #777b74; background: #f3f4ef; font-family: monospace; font-size: .66rem; }
  .footer-inner { display: flex; justify-content: space-between; gap: 1rem; }
  .footer-inner a { color: #171817; text-decoration: none; }
  .reveal { opacity: 1; transform: none; }
  .motion-ready .reveal { opacity: 0; transform: translateY(1rem); transition: opacity 600ms cubic-bezier(.23,1,.32,1), transform 600ms cubic-bezier(.23,1,.32,1); }
  .motion-ready .reveal.is-visible { opacity: 1; transform: translateY(0); }
  .reveal:nth-child(2) { transition-delay: 50ms; }
  .reveal:nth-child(3) { transition-delay: 100ms; }
  .reveal:nth-child(4) { transition-delay: 150ms; }
  @keyframes orbit-one { from { transform: rotate(0deg) scaleY(.55); } to { transform: rotate(360deg) scaleY(.55); } }
  @keyframes orbit-two { from { transform: rotate(-28deg) scaleY(.45); } to { transform: rotate(332deg) scaleY(.45); } }
  @media (hover: hover) and (pointer: fine) { .capability:hover .item-arrow, .work-card:hover, .button:hover { transform: translateY(-3px); transition: transform 160ms cubic-bezier(.23,1,.32,1); } .capability:hover .item-arrow { transform: translate(3px, -3px); } }
  @media (max-width: 800px) { .site-header { grid-template-columns: 1fr auto; } .desktop-nav, .header-cta { display: none; } .mobile-nav { display: block; } .hero { padding-top: 4rem; } .hero-grid, .method-layout, .lab-grid { grid-template-columns: 1fr; } .hero-grid { min-height: auto; } .signal-panel { min-height: 21rem; } .hero-footer { margin-top: 4rem; flex-wrap: wrap; gap: .7rem 1.5rem; } .section-intro { grid-template-columns: 1fr; gap: 1rem; } .capability-list, .work-grid { grid-template-columns: 1fr; } .capability:nth-child(odd) { padding-right: 0; border-right: 0; } .capability:nth-child(even) { padding-left: 0; } .situation { grid-template-columns: 1fr; gap: 1rem; } .footer-inner { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .reveal, .motion-ready .reveal { opacity: 1; transform: none; transition: opacity 200ms ease; } .signal-orbit { animation: none; } .work-card, .button { transition: background-color 160ms ease-out, color 160ms ease-out; } }
</style>
