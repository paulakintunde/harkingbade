---
const capabilities = [
  { number: '01', title: 'Product direction', text: 'Turn a fuzzy opportunity into a sharper decision, offer, and next build.' },
  { number: '02', title: 'Brand and positioning', text: 'Make the value easier to recognise, remember, and choose.' },
  { number: '03', title: 'Content and distribution', text: 'Connect useful stories to the channels and moments where people act.' },
  { number: '04', title: 'Ecommerce and conversion', text: 'Remove friction from the journey between attention, trust, and purchase.' },
  { number: '05', title: 'Web development', text: 'Build fast, accessible web experiences that are ready to learn from.' },
  { number: '06', title: 'AI and motion experiments', text: 'Use emerging tools when they make the work clearer, faster, or more distinctive.' },
];

const situations = [
  { label: 'The signal', title: 'The product works, but the value is difficult to explain.', answer: 'Clarify the promise, the audience, and the moment that matters.' },
  { label: 'The story', title: 'The content exists, but it does not create a clear next action.', answer: 'Shape a useful narrative and connect it to a practical path forward.' },
  { label: 'The surface', title: 'The website looks acceptable, but it does not express the quality of the work.', answer: 'Give the experience a visual system with enough character to be remembered.' },
  { label: 'The decision', title: 'The idea is promising, but the next decision is unclear.', answer: 'Reduce the ambiguity to a small, testable move that can teach you something.' },
];

const placeholders = [
  { index: '01', title: 'Placeholder case study', text: 'A future record of the context, choice, shipped work, and evidence.' },
  { index: '02', title: 'Placeholder experiment', text: 'A future record of a hypothesis, a test, and the signal it created.' },
  { index: '03', title: 'Placeholder build', text: 'A future record of a practical system made useful for a real audience.' },
];

const method = [
  { index: '01', title: 'Notice', text: 'Find the signal beneath the noise.' },
  { index: '02', title: 'Shape', text: 'Make the promise and the choices legible.' },
  { index: '03', title: 'Ship', text: 'Put the smallest useful system into the world.' },
  { index: '04', title: 'Learn', text: 'Use evidence to decide what deserves the next move.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Harkingbade | Product, brand, growth, and build</title>
    <meta name="description" content="Harkingbade connects product, brand, growth, content, ecommerce, web development, AI, and motion into practical next moves." />
    <link rel="canonical" href="https://harkingbade.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4f5f0" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harkingbade" />
    <meta property="og:title" content="Harkingbade | Product, brand, growth, and build" />
