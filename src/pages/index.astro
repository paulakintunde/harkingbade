  .text-link:hover { text-decoration: underline; }
  .signal-panel { position: relative; min-height: 28rem; overflow: hidden; border-radius: 1rem; background: #171817; }
  .signal-panel::before { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0, transparent calc(20% - 1px), rgb(243 244 239 / .08) 20%); content: ''; }
  .signal-orbit { position: absolute; border: 1px solid rgb(255 91 54 / .55); border-radius: 50%; animation: orbit-one 8s linear infinite; }
  .orbit-one { inset: 18% 12%; }
  .orbit-two { inset: 28% 4%; animation-name: orbit-two; animation-direction: reverse; animation-duration: 12s; }
  .signal-core { position: absolute; top: 50%; left: 50%; display: grid; width: min(74%, 20rem); padding: 1.3rem; gap: .45rem; transform: translate(-50%, -50%); border: 1px solid rgb(243 244 239 / .3); background: rgb(23 24 23 / .9); box-shadow: 0 2rem 5rem rgb(0 0 0 / .25); }
  .signal-core span, .signal-caption, .lab-label { color: #ff5b36; font-family: monospace; font-size: .63rem; letter-spacing: .1em; text-transform: uppercase; }
  .signal-core strong { color: #f3f4ef; font-size: 1.1rem; }
  .signal-core i { color: #ff5b36; font-size: 1.7rem; font-style: normal; }
  .signal-caption { position: absolute; right: 1rem; bottom: 1rem; }
  .hero-footer { display: flex; justify-content: space-between; border-top: 1px solid rgb(23 24 23 / .2); padding-top: 1rem; color: #777b74; font-family: monospace; font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; }
  .section { padding: clamp(6rem, 12vw, 12rem) 0; }
  .section-intro { display: grid; margin-bottom: clamp(3rem, 7vw, 6rem); grid-template-columns: minmax(0, .9fr) minmax(16rem, .7fr); gap: 2rem 5rem; align-items: end; }
