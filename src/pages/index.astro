  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Harkingbade home"><span class="brand-mark">H</span><span>harkingbade</span></a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#capabilities">Services</a><a href="#work">Work</a><a href="#notes">Notes</a><a href="#about">About</a>
      </nav>
