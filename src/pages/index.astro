---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const featuredWork = await getCollection('work', ({ data }) => data.featured && !data.draft);
const featuredInsights = (await getCollection('insight', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);

const routes = [
  { number: '01', title: 'Make a place bookable', audience: 'Airbnb + short-stay hosts', description: 'Turn existing property photos into a cinematic social story, a sharper listing, and a direct path to booking.', href: '/services/#property', tone: 'lime' },
  { number: '02', title: 'Make a product scroll-stopping', audience: 'Etsy, eBay + Shopify sellers', description: 'Create motion-led product content, sharper hooks, and conversion fixes from the assets you already have.', href: '/services/#commerce', tone: 'coral' },
  { number: '03', title: 'Make an idea shippable', audience: 'Founders + lean product teams', description: 'Find the useful promise, shape the offer, and connect product, brand, content, and delivery into one move.', href: '/services/#launch', tone: 'ink' },
  { number: '04', title: 'Make your next move legible', audience: 'Hiring teams + collaborators', description: 'See the product, growth, design, AI, and web development range behind the work—and the evidence behind the claims.', href: '/career/', tone: 'paper' },
];
---

<BaseLayout>
  <section class="hero hero--lab">
    <div class="container hero-topline"><span>HB / OPPORTUNITY LAB</span><span>01 — 04 / OPEN</span></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">AI media · product · growth · build</p>
        <h1>Turn what you already have into <em>attention that moves.</em></h1>
        <p class="lede">Harkingbade helps hosts, sellers, founders, and teams turn static assets or fuzzy ideas into useful stories, better experiences, and opportunities people can act on.</p>
        <div class="button-row">
          <a class="button button--lime" href="#routes" data-track-event="cta_click" data-track-cta="home-routes" data-track-audience="services">Find your starting point <span aria-hidden="true">↘</span></a>
          <a class="button button--dark-ghost" href="/work/" data-track-event="cta_click" data-track-cta="home-proof" data-track-audience="proof">See the proof</a>
        </div>
        <p class="hero-note"><span class="status-dot" aria-hidden="true"></span> One person, many useful ways to make the opportunity clearer.</p>
      </div>

      <div class="opportunity-console" aria-label="Choose an opportunity path">
        <div class="console-head"><span>OPPORTUNITY SCAN</span><span class="console-live">READY</span></div>
        <div class="motion-preview" data-remotion-composition="OpportunitySignal" aria-label="Animated Harkingbade opportunity signal">
          <div class="motion-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          <div class="motion-stage"><span>INPUT</span><strong>property photos</strong><b>→</b><span>OUTPUT</span><strong>reasons to act</strong></div>
          <span class="motion-label">REMOTION / SIGNAL FEED</span>
        </div>
        <p class="console-question">What do you have right now?</p>
        <div class="console-options">
          <a href="#routes"><span>01</span><strong>Property photos</strong><b>↗</b></a>
          <a href="#routes"><span>02</span><strong>Product listings</strong><b>↗</b></a>
          <a href="#routes"><span>03</span><strong>A half-formed idea</strong><b>↗</b></a>
          <a href="/career/"><span>04</span><strong>A hiring question</strong><b>↗</b></a>
        </div>
        <div class="console-output"><span>THE COMMON OUTPUT</span><strong>Proof <i>→</i> product <i>→</i> demand</strong></div>
      </div>
    </div>
    <div class="container hero-signal"><span>BUILD IN PUBLIC</span><span>HUMAN JUDGEMENT</span><span>AI-ACCELERATED</span><span>OUTCOME-LED</span></div>
  </section>

  <section class="section section--paper" id="routes">
    <div class="container">
      <SectionHeading eyebrow="Start with the buyer" title="A useful service should be obvious in five seconds." description="Pick the situation that sounds like yours. The work changes shape, but the operating principle stays the same: make the value visible, then make the next action easy." />
      <div class="route-grid">
        {routes.map((route) => (
          <article class:list={['route-card', `route-card--${route.tone}`]}>
            <div class="route-top"><span>{route.number}</span><span aria-hidden="true">↗</span></div>
            <div><p class="route-audience">{route.audience}</p><h2><a href={route.href}>{route.title}</a></h2><p>{route.description}</p></div>
            <a class="route-link" href={route.href}>Explore this path <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink proof-section">
    <div class="container">
      <SectionHeading eyebrow="Proof, not posture" title="The work stays close to the evidence." description="Case studies, field notes, and experiments show what was observed, what was decided, what shipped, and what is still unknown." />
      <div class="proof-grid">
        {featuredWork.map((entry) => (
          <article class="proof-feature">
            <div class="meta"><span class="tag">{entry.data.status}</span><span>Live case study</span></div>
            <h2><a href={`/work/${entry.id}/`}>{entry.data.title}</a></h2>
            <p>{entry.data.description}</p>
            <a class="text-link" href={`/work/${entry.id}/`}>Read the recovery log <span aria-hidden="true">↗</span></a>
          </article>
        ))}
        <aside class="proof-standard"><span class="stamp">HB / STANDARD 01</span><strong>No invented wins.</strong><p>Unknown metrics stay unknown. Work in progress is labelled. Material updates are dated.</p></aside>
      </div>
    </div>
  </section>

  <section class="section section--paper loop-section">
    <div class="container loop-grid">
      <div><p class="eyebrow">The working loop</p><h2>Make the story.<br /><em>Ship the signal.</em></h2><p class="lede">Product thinking, visual design, AI execution, social distribution, and web development are not separate menus here. They are tools for one job: helping the right people understand and choose.</p></div>
      <ol class="loop-list">
        <li><span>01</span><strong>Notice</strong><em>Find the friction.</em></li>
        <li><span>02</span><strong>Shape</strong><em>Make the value legible.</em></li>
        <li><span>03</span><strong>Make</strong><em>Build the useful thing.</em></li>
        <li><span>04</span><strong>Move</strong><em>Put it where demand lives.</em></li>
      </ol>
    </div>
  </section>

  <section class="section section--dark-accent">
    <div class="container">
      <SectionHeading eyebrow="Field notes" title="Useful ideas, attached to a real build." description="Deep teardowns, implementation notes, and experiments across AI, product, commerce, content, and growth." />
      <div class="note-grid">
        {featuredInsights.map((entry) => (
          <article class="note-card"><div class="meta"><span>{entry.data.pillar}</span><span>{entry.data.evidenceType}</span></div><h2><a href={`/insights/${entry.id}/`}>{entry.data.title}</a></h2><p>{entry.data.description}</p></article>
        ))}
      </div>
      <div class="button-row"><a class="button button--light" href="/insights/">Browse field notes</a><a class="button button--dark-ghost" href="/lab/">Open the lab</a></div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-grid"><div><p class="eyebrow">Have an asset, offer, or opportunity?</p><h2>Bring the raw material.<br /><em>Leave with a next move.</em></h2></div><div class="stack-lg flow-end"><p class="lede">Tell me what you have, who it needs to reach, and what should happen next. I will point you to the smallest useful starting point.</p><div><a class="button" href="/contact/" data-track-event="cta_click" data-track-cta="home-contact" data-track-audience="services">Start a conversation <span aria-hidden="true">↗</span></a></div></div></div>
  </section>
</BaseLayout>

<style>
  .hero--lab { color: var(--paper-2); background: var(--ink); }
  .hero-topline { display: flex; padding-top: 1.15rem; justify-content: space-between; color: #a9b4c1; font-family: var(--mono); font-size: .68rem; font-weight: 800; letter-spacing: .1em; }
  .hero-grid { display: grid; padding-block: clamp(4.5rem, 9vw, 8rem); grid-template-columns: minmax(0, 1.12fr) minmax(20rem, .88fr); gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  .hero-copy h1 { max-width: 56rem; color: var(--paper-2); font-size: clamp(3.6rem, 7.6vw, 7.7rem); }
  .hero-copy h1 em, .loop-grid h2 em, .final-cta h2 em { color: var(--lime); font-style: normal; }
  .hero-copy .lede { max-width: 39rem; margin-top: 1.8rem; color: #c1cad4; }
  .button--lime { border-color: var(--lime); color: var(--ink); background: var(--lime); }
  .button--dark-ghost { border-color: #65717e; color: var(--paper-2); background: transparent; }
  .button--dark-ghost:hover { border-color: var(--lime); box-shadow: 0 .5rem 0 var(--lime); }
  .hero-note { display: flex; margin-top: 2rem; gap: .6rem; align-items: center; color: #a9b4c1; font-family: var(--mono); font-size: .7rem; text-transform: uppercase; }
  .status-dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--lime); box-shadow: 0 0 .75rem var(--lime); }
  .opportunity-console { padding: 1.2rem; border: 1px solid #65717e; background: linear-gradient(145deg, #19202a, #10151c); box-shadow: .85rem .85rem 0 var(--coral); }
  .console-head, .console-output, .route-top { display: flex; justify-content: space-between; font-family: var(--mono); font-size: .68rem; font-weight: 800; letter-spacing: .1em; }
  .console-head { padding-bottom: 1rem; border-bottom: 1px solid #36414d; color: #9eabb9; }
  .console-live { color: var(--lime); }
  .motion-preview { position: relative; margin-top: 1rem; overflow: hidden; border: 1px solid #36414d; background: #0b0f14; aspect-ratio: 16 / 9; }
  .motion-grid { position: absolute; inset: 0; background-image: linear-gradient(#36414d 1px, transparent 1px), linear-gradient(90deg, #36414d 1px, transparent 1px); background-size: 32px 32px; opacity: .32; animation: motion-pan 8s linear infinite; }
  .motion-grid i { position: absolute; width: .42rem; height: .42rem; border-radius: 50%; background: var(--lime); box-shadow: 0 0 .5rem var(--lime); animation: motion-pulse 2.4s ease-in-out infinite; }
  .motion-grid i:nth-child(1) { top: 20%; left: 18%; }
  .motion-grid i:nth-child(2) { top: 68%; left: 34%; animation-delay: .4s; }
  .motion-grid i:nth-child(3) { top: 36%; right: 23%; animation-delay: .8s; }
  .motion-grid i:nth-child(4) { bottom: 17%; right: 12%; animation-delay: 1.2s; }
  .motion-grid i:nth-child(5) { top: 17%; right: 47%; animation-delay: 1.6s; }
  .motion-grid i:nth-child(6) { bottom: 22%; left: 11%; animation-delay: 2s; }
  .motion-stage { position: absolute; inset: 0; display: grid; padding: 1.1rem; grid-template-columns: auto 1fr auto auto 1fr; gap: .55rem; align-items: center; color: var(--paper-2); font-family: var(--mono); font-size: .58rem; }
  .motion-stage span { color: var(--lime); font-size: .52rem; letter-spacing: .08em; }
  .motion-stage strong { color: var(--paper-2); font-family: var(--sans); font-size: .72rem; }
  .motion-stage b { color: var(--coral); font-size: 1.1rem; animation: motion-arrow 1.4s ease-in-out infinite; }
  .motion-label { position: absolute; right: .65rem; bottom: .55rem; padding: .25rem .4rem; color: var(--lime); background: rgba(13, 17, 23, .84); font-family: var(--mono); font-size: .58rem; font-weight: 800; letter-spacing: .08em; }
  @keyframes motion-pan { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(32px, 32px, 0); } }
  @keyframes motion-pulse { 0%, 100% { transform: scale(.7); opacity: .4; } 50% { transform: scale(1.5); opacity: 1; } }
  @keyframes motion-arrow { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(.35rem); } }
  .console-question { margin: 2rem 0 1rem; color: var(--paper-2); font-size: 1.35rem; font-weight: 800; }
  .console-options { display: grid; gap: .6rem; }
  .console-options a { display: grid; padding: .9rem .75rem; grid-template-columns: 2rem 1fr auto; gap: .5rem; align-items: center; border: 1px solid #36414d; color: var(--paper-2); text-decoration: none; transition: border-color .18s ease, background .18s ease, transform .18s ease; }
  .console-options a:hover { border-color: var(--lime); background: #26313a; transform: translateX(.25rem); }
  .console-options span, .console-options b { color: var(--lime); font-family: var(--mono); font-size: .7rem; }
  .console-options strong { font-size: .95rem; }
  .console-output { display: grid; margin-top: 2rem; gap: .4rem; color: #9eabb9; }
  .console-output strong { color: var(--paper-2); font-family: var(--sans); font-size: 1rem; letter-spacing: -.02em; }
  .console-output i { color: var(--coral); font-style: normal; }
  .hero-signal { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #36414d; }
  .hero-signal span { padding: .9rem .5rem; border-right: 1px solid #36414d; color: #9eabb9; font-family: var(--mono); font-size: .65rem; font-weight: 800; letter-spacing: .06em; text-align: center; }
  .route-grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  .route-card { display: flex; min-height: 23rem; padding: clamp(1.35rem, 3vw, 2.2rem); flex-direction: column; justify-content: space-between; border: 1px solid var(--ink); background: var(--paper-2); box-shadow: .45rem .45rem 0 var(--ink); }
  .route-card--lime { background: var(--lime); }
  .route-card--coral { background: var(--coral); }
  .route-card--ink { color: var(--paper-2); background: var(--ink); }
  .route-card--paper { background: #e3e7e3; }
  .route-top { margin-bottom: 2.5rem; }
  .route-audience { margin-bottom: .75rem; font-family: var(--mono); font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .route-card h2 { max-width: 25rem; margin-bottom: 1rem; font-family: var(--display); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 850; letter-spacing: -.065em; }
  .route-card h2 a { text-decoration: none; }
  .route-card h2 a:hover { text-decoration: underline; }
  .route-card p { max-width: 30rem; }
  .route-link, .text-link { display: inline-flex; margin-top: 2rem; gap: .45rem; align-items: center; font-weight: 800; text-decoration: none; }
  .route-link span, .text-link span { color: var(--blue); }
  .proof-section { background: var(--ink); }
  .proof-section .section-heading h2 { color: var(--paper-2); }
  .proof-section .section-heading .lede { color: #c1cad4; }
  .proof-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(15rem, .65fr); gap: 1rem; }
  .proof-feature { min-height: 26rem; padding: clamp(1.4rem, 3vw, 2.4rem); border: 1px solid #65717e; background: #151c24; }
  .proof-feature .meta { color: #a9b4c1; }
  .proof-feature h2 { max-width: 46rem; margin-block: 4rem 1.25rem; color: var(--paper-2); font-family: var(--display); font-size: clamp(2.2rem, 4.5vw, 4.8rem); font-weight: 850; }
  .proof-feature h2 a { text-decoration: none; }
  .proof-feature h2 a:hover { color: var(--lime); }
  .proof-feature p { max-width: 38rem; color: #c1cad4; }
  .proof-feature .text-link { color: var(--paper-2); }
  .proof-standard { display: flex; min-height: 26rem; padding: 1.5rem; flex-direction: column; justify-content: space-between; border: 1px solid var(--ink); background: var(--lime); }
  .stamp { font-family: var(--mono); font-size: .68rem; font-weight: 800; letter-spacing: .08em; }
  .proof-standard strong { max-width: 12rem; font-family: var(--display); font-size: clamp(2rem, 3vw, 3.2rem); line-height: .95; letter-spacing: -.06em; }
  .proof-standard p { max-width: 20rem; }
  .loop-grid, .final-cta-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .9fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .loop-grid h2, .final-cta h2 { margin-bottom: 1.5rem; font-size: clamp(3rem, 6vw, 6rem); }
  .loop-list { border-top: 1px solid var(--ink); list-style: none; }
  .loop-list li { display: grid; padding: 1rem 0; grid-template-columns: 3rem 1fr auto; gap: 1rem; align-items: center; border-bottom: 1px solid var(--ink); }
  .loop-list span { font-family: var(--mono); font-size: .7rem; }
  .loop-list strong { font-size: 1.45rem; }
  .loop-list em { color: var(--ink-2); font-size: .9rem; }
  .section--dark-accent { color: var(--paper-2); background: #20293a; }
  .section--dark-accent .section-heading h2 { color: var(--paper-2); }
  .section--dark-accent .section-heading .lede { color: #c1cad4; }
  .note-grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  .note-card { min-height: 19rem; padding: 1.5rem; border: 1px solid #65717e; background: #2b374b; }
  .note-card .meta { color: #c1cad4; }
  .note-card h2 { margin-block: 3.5rem 1rem; color: var(--paper-2); font-family: var(--display); font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 850; }
  .note-card h2 a { text-decoration: none; }
  .note-card h2 a:hover { color: var(--lime); }
  .note-card p { color: #c1cad4; }
  .final-cta { background: var(--lime); }
  .final-cta .lede { color: var(--ink-2); }
  @media (max-width: 850px) { .hero-grid, .loop-grid, .final-cta-grid { grid-template-columns: 1fr; } .hero-grid { padding-block: 4rem; } .proof-grid { grid-template-columns: 1fr; } }
  @media (max-width: 650px) { .hero-signal { grid-template-columns: 1fr 1fr; } .hero-signal span:nth-child(2) { border-right: 0; } .route-grid, .note-grid { grid-template-columns: 1fr; } .route-card { min-height: 19rem; } .proof-feature h2 { margin-top: 3rem; } }
</style>
