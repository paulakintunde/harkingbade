---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { diagnosticQuestions, stageMeta, type DiagnosticStage } from '../../lib/diagnostic';
import { site } from '../../data/site';

const stages = Object.keys(stageMeta) as DiagnosticStage[];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '4D Product & Growth Diagnostic',
  url: `${site.url}/resources/4d-diagnostic/`,
  description:
    'A private browser-based self-assessment across customer evidence, product strategy, positioning, delivery, distribution, and growth learning.',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout
  title={`4D Product & Growth Diagnostic — ${site.name}`}
  description="Score the connections between customer evidence, product decisions, positioning, delivery, distribution, and growth learning in about seven minutes."
  structuredData={structuredData}
>
  <header class="page-hero container">
    <p class="eyebrow">Free private self-assessment</p>
    <h1>Find the weakest link in your <span class="accent">product and growth system.</span></h1>
    <p class="lede">Rate 16 evidence statements across Discover, Define, Deliver, and Drive. Your answers stay in this browser and are not submitted to Harkingbade.</p>
    <div class="diagnostic-facts" aria-label="Diagnostic facts">
      <span>16 statements</span><span>About 7 minutes</span><span>No email gate</span><span>No data saved</span>
    </div>
  </header>

  <section class="section section--paper diagnostic-shell">
    <form class="container diagnostic-form" data-diagnostic novalidate>
      <div class="scale-key" aria-label="Response scale">
        <p><strong>Rate the evidence, not the ambition.</strong> Choose the answer that is demonstrably true today.</p>
        <ol><li><b>1</b> Not true</li><li><b>2</b> Rarely true</li><li><b>3</b> Partly true</li><li><b>4</b> Usually true</li><li><b>5</b> Demonstrably true</li></ol>
      </div>

      {stages.map((stage) => (
        <section class="question-stage" aria-labelledby={`${stage}-heading`}>
          <header>
            <span>{stageMeta[stage].number}</span>
            <div><h2 id={`${stage}-heading`}>{stageMeta[stage].name}</h2><p>{stageMeta[stage].description}</p></div>
          </header>
          <div class="question-list">
            {diagnosticQuestions.filter((question) => question.stage === stage).map((question, index) => (
              <fieldset data-question>
                <legend><span>{stageMeta[stage].number}.{index + 1}</span>{question.prompt}</legend>
                <p>{question.evidenceHint}</p>
                <div class="rating" role="radiogroup" aria-label={`Rate: ${question.prompt}`}>
                  {[1, 2, 3, 4, 5].map((value) => (
                    <label><input type="radio" name={question.id} value={value} required /><span>{value}</span></label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>
        </section>
      ))}

      <div class="submit-panel">
        <div><p class="eyebrow">Decision, not diagnosis theatre</p><h2>Turn the pattern into one next move.</h2><p>This is a structured reflection tool, not a validated benchmark or substitute for customer, product, financial, or operational evidence.</p></div>
        <div><button class="button" type="submit">Calculate my result</button><p class="form-error" role="alert" data-diagnostic-error></p></div>
      </div>
    </form>
  </section>

  <section class="section section--ink result" data-diagnostic-result hidden aria-live="polite">
    <div class="container result-grid">
      <div class="result-summary">
        <p class="eyebrow">Your current pattern</p>
        <h2 tabindex="-1" data-result-heading><span data-result-band>—</span></h2>
        <p class="score"><strong data-result-total>—</strong><span>/ 80</span></p>
        <p class="lede" data-result-interpretation></p>
        <p class="result-note">Scores reflect your answers, not an external benchmark. Validate the pattern with evidence and other people involved in the system.</p>
      </div>
      <div class="stage-results">
        {stages.map((stage) => (
          <div class="stage-result" data-stage-result={stage}>
            <div><span>{stageMeta[stage].number} / {stageMeta[stage].name}</span><strong><b data-stage-score>—</b> / 20</strong></div>
            <div class="meter" aria-hidden="true"><i data-stage-meter></i></div>
          </div>
        ))}
      </div>
    </div>
    <div class="container next-move">
      <div><p class="eyebrow">Start here</p><h2 data-primary-stage>—</h2></div>
      <ol data-result-actions></ol>
      <div class="button-row no-print">
        <a class="button button--light" href="/contact/?interest=diagnostic&source=4d-diagnostic" data-diagnostic-cta>Discuss a Product & Growth Diagnostic</a>
        <a class="button button--ghost" href="/resources/4d-decision-canvas/" data-diagnostic-cta>Open the decision canvas</a>
        <button class="button button--ghost" type="button" data-result-print>Print result</button>
        <button class="button button--ghost" type="button" data-result-reset>Retake</button>
      </div>
    </div>
  </section>

  <script>
    import { scoreDiagnostic, stageMeta, type DiagnosticStage } from '../../lib/diagnostic';

    const form = document.querySelector<HTMLFormElement>('[data-diagnostic]');
    const resultSection = document.querySelector<HTMLElement>('[data-diagnostic-result]');
    const error = document.querySelector<HTMLElement>('[data-diagnostic-error]');
    const resultHeading = document.querySelector<HTMLElement>('[data-result-heading]');
    const emitAnalytics = (event: string, properties: Record<string, string | number>) => {
      document.dispatchEvent(new CustomEvent('harkingbade:track', { detail: { event, properties } }));
    };
    let diagnosticStarted = false;
    let currentPrimaryStage = '';

    form?.addEventListener('change', (event) => {
      if (diagnosticStarted || !(event.target instanceof HTMLInputElement)) return;
      diagnosticStarted = true;
      emitAnalytics('diagnostic_start', {
        source_page: window.location.pathname,
        resource_id: '4d-diagnostic',
      });
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form || !resultSection || !error) return;

      const missing = form.querySelector<HTMLInputElement>('[data-question] input:required:invalid');
      if (missing) {
        error.textContent = 'Answer every statement before calculating the result.';
        missing.closest('fieldset')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        missing.focus({ preventScroll: true });
        return;
      }

      const answers: Record<string, number> = {};
      for (const [key, value] of new FormData(form).entries()) {
        if (typeof value === 'string') answers[key] = Number(value);
      }

      try {
        const result = scoreDiagnostic(answers);
        currentPrimaryStage = result.primaryStage;
        error.textContent = '';
        const band = document.querySelector<HTMLElement>('[data-result-band]');
        const total = document.querySelector<HTMLElement>('[data-result-total]');
        const interpretation = document.querySelector<HTMLElement>('[data-result-interpretation]');
        const primary = document.querySelector<HTMLElement>('[data-primary-stage]');
        const actions = document.querySelector<HTMLOListElement>('[data-result-actions]');
        if (band) band.textContent = result.band;
        if (total) total.textContent = String(result.total);
        if (interpretation) interpretation.textContent = result.interpretation;
        if (primary) primary.textContent = `${stageMeta[result.primaryStage].name} is the first constraint to examine.`;
        if (actions) {
          actions.replaceChildren(...result.actions.map((action) => {
            const item = document.createElement('li');
            item.textContent = action;
            return item;
          }));
        }

        for (const [stage, score] of Object.entries(result.stageScores) as [DiagnosticStage, number][]) {
          const stageResult = document.querySelector<HTMLElement>(`[data-stage-result="${stage}"]`);
          const value = stageResult?.querySelector<HTMLElement>('[data-stage-score]');
          const meter = stageResult?.querySelector<HTMLElement>('[data-stage-meter]');
          if (value) value.textContent = String(score);
          if (meter) meter.style.width = `${(score / 20) * 100}%`;
          stageResult?.toggleAttribute('data-weakest', result.weakestStages.includes(stage));
        }

        resultSection.hidden = false;
        resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        resultHeading?.focus({ preventScroll: true });
        emitAnalytics('diagnostic_complete', {
          source_page: window.location.pathname,
          resource_id: '4d-diagnostic',
          band: result.band,
          primary_stage: result.primaryStage,
          total_score: result.total,
        });
      } catch {
        error.textContent = 'The result could not be calculated. Review the responses and try again.';
      }
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-diagnostic-cta]').forEach((anchor) => {
      anchor.addEventListener('click', () => {
        emitAnalytics('diagnostic_cta', {
          source_page: window.location.pathname,
          resource_id: '4d-diagnostic',
          destination: new URL(anchor.href).pathname,
          primary_stage: currentPrimaryStage || 'unknown',
        });
      });
    });
    document.querySelector('[data-result-print]')?.addEventListener('click', () => {
      emitAnalytics('resource_use', {
        source_page: window.location.pathname,
        resource_id: '4d-diagnostic',
        action: 'print',
      });
      window.print();
    });
    document.querySelector('[data-result-reset]')?.addEventListener('click', () => {
      form?.reset();
      if (resultSection) resultSection.hidden = true;
      form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</BaseLayout>

<style>
  .diagnostic-facts { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2rem; }
  .diagnostic-facts span { padding: .35rem .65rem; border: 1px solid var(--ink); border-radius: 999px; font-family: var(--mono); font-size: .68rem; font-weight: 800; text-transform: uppercase; }
  .diagnostic-shell { padding-top: 2rem; }
  .diagnostic-form { display: grid; gap: 4rem; }
  .scale-key { position: sticky; z-index: 4; top: 4.5rem; display: grid; padding: 1rem; grid-template-columns: 1fr auto; gap: 1rem; align-items: center; border: 1px solid var(--ink); background: var(--lime); box-shadow: 0 .35rem 0 var(--ink); }
  .scale-key p { font-size: .82rem; }
  .scale-key ol { display: flex; gap: .35rem; list-style: none; }
  .scale-key li { padding: .25rem .45rem; border-left: 1px solid var(--ink); font-family: var(--mono); font-size: .62rem; }
  .scale-key b { display: block; font-size: .85rem; }
  .question-stage { display: grid; gap: 1.5rem; grid-template-columns: minmax(13rem, .32fr) minmax(0, .68fr); scroll-margin-top: 8rem; }
  .question-stage > header { align-self: start; }
  .question-stage > header > span { display: block; margin-bottom: 1rem; color: var(--blue); font-family: var(--mono); font-size: 1rem; font-weight: 900; }
  .question-stage h2 { font-size: clamp(2.5rem, 5vw, 4rem); }
  .question-stage header p { margin-top: .75rem; color: var(--ink-2); }
  .question-list { display: grid; gap: .75rem; }
  fieldset { display: grid; padding: 1.25rem; gap: .65rem; border: 1px solid var(--line); background: #fff; }
  fieldset:focus-within { border-color: var(--blue); box-shadow: 0 0 0 2px var(--blue); }
  legend { max-width: 52rem; padding: 0 .4rem; font-weight: 850; line-height: 1.35; }
  legend span { margin-right: .6rem; color: var(--blue); font-family: var(--mono); font-size: .72rem; }
  fieldset > p { color: var(--ink-2); font-size: .8rem; }
  .rating { display: grid; max-width: 26rem; grid-template-columns: repeat(5, 1fr); gap: .4rem; }
  .rating label { cursor: pointer; }
  .rating input { position: absolute; opacity: 0; pointer-events: none; }
  .rating span { display: grid; min-height: 2.75rem; place-items: center; border: 1px solid var(--ink); background: var(--paper-2); font-family: var(--mono); font-weight: 900; }
  .rating input:checked + span { color: #fff; background: var(--blue); box-shadow: inset 0 0 0 2px #fff; }
  .rating input:focus-visible + span { outline: 3px solid var(--blue); outline-offset: 2px; }
  .submit-panel { display: grid; padding: clamp(1.5rem, 4vw, 3rem); grid-template-columns: 1.3fr .7fr; gap: 2rem; align-items: end; color: var(--paper-2); background: var(--ink); }
  .submit-panel h2 { max-width: 44rem; }
  .submit-panel p { max-width: 42rem; color: #cad4cc; }
  .form-error { min-height: 1.5rem; margin-top: .75rem; color: #ffad99 !important; font-weight: 800; }
  .result[hidden] { display: none; }
  .result-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 4rem; }
  .result-summary h2 { color: var(--lime); }
  .score { display: flex; margin-block: 1.5rem; gap: .5rem; align-items: baseline; font-family: var(--mono); }
  .score strong { font-size: 4rem; line-height: 1; }
  .score span { color: #cad4cc; }
  .result-note { margin-top: 1.5rem; color: #aebbb1; font-size: .82rem; }
  .stage-results { display: grid; align-content: center; gap: 1.5rem; }
  .stage-result > div:first-child { display: flex; margin-bottom: .45rem; justify-content: space-between; font-family: var(--mono); font-size: .75rem; text-transform: uppercase; }
  .stage-result[data-weakest] > div:first-child { color: var(--coral); }
  .meter { height: .65rem; overflow: hidden; background: #4a5a50; }
  .meter i { display: block; width: 0; height: 100%; background: var(--lime); transition: width .6s ease; }
  .stage-result[data-weakest] .meter i { background: var(--coral); }
  .next-move { display: grid; margin-top: 5rem; padding-top: 3rem; grid-template-columns: .8fr 1.2fr; gap: 3rem; border-top: 1px solid #4a5a50; }
  .next-move h2 { font-size: clamp(2.2rem, 4vw, 3.5rem); }
  .next-move ol { counter-reset: next; list-style: none; }
  .next-move li { position: relative; padding: 1rem 0 1rem 3rem; border-bottom: 1px solid #4a5a50; color: #d9e0da; }
  .next-move li::before { position: absolute; left: 0; color: var(--lime); font-family: var(--mono); content: '0' counter(next); counter-increment: next; }
  .next-move .button-row { grid-column: 1 / -1; }
  .next-move .button--ghost { border-color: var(--paper-2); color: var(--paper-2); }
  @media (max-width: 850px) {
    .scale-key { position: static; grid-template-columns: 1fr; }
    .scale-key ol { flex-wrap: wrap; }
    .question-stage, .submit-panel, .result-grid, .next-move { grid-template-columns: 1fr; }
    .next-move .button-row { grid-column: auto; }
  }
  @media (max-width: 500px) { .scale-key li { width: calc(50% - .25rem); } .rating { max-width: none; } }
  @media print {
    :global(.site-header), :global(.site-footer), .diagnostic-shell, .page-hero, .no-print { display: none !important; }
    .result { display: block !important; padding: 0; color: #000; background: #fff; }
    .result-grid, .next-move { grid-template-columns: 1fr 1fr; }
    .result-summary h2, .stage-result[data-weakest] > div:first-child { color: #000; }
    .meter { border: 1px solid #000; background: #fff; }
    .meter i, .stage-result[data-weakest] .meter i { background: #000; }
  }
</style>
