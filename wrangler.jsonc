{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harkingbade",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TURNSTILE_ENFORCED": "false",
    "ANALYTICS_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "TURNSTILE_ENFORCED": "false",
        "ANALYTICS_ENABLED": "false"
      }
    },
    "production": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "harkingbade.com",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "TURNSTILE_ENFORCED": "false",
        "ANALYTICS_ENABLED": "false"
      }
    }
  }
}
